    "segments": [
      "Va vấp đủ rồi, thôi chứng minh,",
      "Đàn ông đâu mãi phải gồng mình.",
      "Những ngày tự biết vai đã mỏi.",
      "Dám dừng lại, cũng là bản lĩnh."
