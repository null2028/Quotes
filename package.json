{
  "name": "tra-nguoi-studio",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "map-only": "tsx src/cli/batchRender.ts --map-only",
    "render:batch": "tsx src/cli/batchRender.ts",
    "server": "tsx watch server/index.ts",
    "ui": "vite --config studio-ui/vite.config.ts",
    "ui:build": "vite build --config studio-ui/vite.config.ts",
    "desktop": "node --import ./node_modules/tsx/dist/loader.mjs server/studioDesktop.ts",
    "app": "concurrently -n SERVER,STUDIO -c yellow,cyan \"npm run server\" \"npm run ui\""
  },
  "dependencies": {
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "@remotion/media": "4.0.542",
    "@remotion/paths": "4.0.542",
    "@remotion/player": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "@remotion/shapes": "4.0.542",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.542",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.11"
  }
}
